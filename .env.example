# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API) -------------------------------------------
# Local stack: run `npx supabase start` and copy the printed API URL and keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key. Safe for the browser; RLS protects the data.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as a fallback name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# Secret (service-role) key. SERVER ONLY: never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY is accepted as a fallback name.
SUPABASE_SECRET_KEY=replace-with-secret-or-service-role-key

# --- App ---------------------------------------------------------------------------
# Public origin, used in email links. Must be listed in Supabase Auth → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Gitam Trades

# --- Grievance / support contact (defaults in src/lib/config.ts) ----------------------
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Dhanush
NEXT_PUBLIC_GRIEVANCE_EMAIL=dhanush@gitamtrades.in
NEXT_PUBLIC_GRIEVANCE_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=dhanush@gitamtrades.in

# --- E2E tests (optional; local stack only) --------------------------------------------
# E2E_SUPABASE=1
# E2E_EMAIL_DOMAIN=student.gitam.edu
# E2E_MAILPIT_URL=http://127.0.0.1:54324
